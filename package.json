{
  "name": "homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_OPTIONS='--max-old-space-size=1024' PORT=3000 HOST=0.0.0.0 PROTOCOL_HEADER=x-forwarded-proto BODY_SIZE_LIMIT=105000000 node --env-file=.env.local build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "otplib": "^13.4.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  }
}
